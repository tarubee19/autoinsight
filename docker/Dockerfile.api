# API + agent workflow.   Build from the repo root:  docker build -f docker/Dockerfile.api -t autoinsight-api .
FROM python:3.13-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    AUTOINSIGHT_RUNS_DIR=/app/runs \
    AUTOINSIGHT_SAMPLES_DIR=/app/data/sample

WORKDIR /app
COPY constraints.txt pyproject.toml README.md ./
COPY src ./src
RUN pip install --no-cache-dir -c constraints.txt ".[api,llm]"

# Docker CLI only (no daemon): lets the API start sandbox containers when a socket is mounted (see docker-compose.llm.yml).
COPY --from=docker:cli /usr/local/bin/docker /usr/local/bin/docker

COPY data/sample ./data/sample
RUN useradd --create-home --uid 1000 app && mkdir -p /app/runs && chown -R app:app /app/runs
USER app

EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
  CMD python -c "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8000/health', timeout=4).status == 200 else 1)"
CMD ["uvicorn", "autoinsight.api:app", "--host", "0.0.0.0", "--port", "8000"]

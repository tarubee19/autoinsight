# Copy to .env  (docker compose reads it automatically; for local runs: `set -a; source .env; set +a`)

# --- LLM (optional). With no key the system runs in offline mode using vetted code templates. -----
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# auto | anthropic | openai | offline     (auto = Anthropic if its key is set, else OpenAI, else offline)
AUTOINSIGHT_LLM_PROVIDER=auto
# Model override, e.g. a current Claude or GPT model name you have access to (defaults are in src/autoinsight/llm.py)
AUTOINSIGHT_MODEL=

# --- Sandbox -----------------------------------------------------------------------------------
# auto | docker | local.  LLM-written code is only run in `docker` (or `local` with the explicit opt-in below).
AUTOINSIGHT_SANDBOX_MODE=auto
AUTOINSIGHT_ALLOW_UNSAFE_LOCAL=0
AUTOINSIGHT_SANDBOX_TIMEOUT_S=120
AUTOINSIGHT_SANDBOX_MEMORY_MB=2048
AUTOINSIGHT_MAX_CODE_ATTEMPTS=3

# --- Privacy / limits ----------------------------------------------------------------------------
# Send 3 example values per column to the LLM (0 = only names, types and statistics)
AUTOINSIGHT_SEND_SAMPLE_VALUES=1
AUTOINSIGHT_MAX_UPLOAD_MB=50
# Delete runs older than N hours (0 = keep forever). Recommended for public demos.
AUTOINSIGHT_RETENTION_HOURS=0

# --- API protection (set for any public deployment) ------------------------------------------------
AUTOINSIGHT_API_KEY=
